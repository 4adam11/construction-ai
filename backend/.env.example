# Get a key at https://platform.claude.com. Leave empty to run in mock mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
# Re-run declined requests on a fallback model (server-side). true/false
CLAUDE_FALLBACKS=true
# auto = mock only when no API key is set; true/false to force
MOCK_MODE=auto
CORS_ORIGINS=http://localhost:5174
